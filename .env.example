APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# NEVER set APP_DEBUG=true outside local: the debug page prints the environment,
# stack traces and query bindings to anyone who triggers an error. Production
# must run APP_ENV=production with APP_DEBUG=false.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in every HTTPS environment so the session cookie is never sent
# over plain HTTP. Left unset locally, where the dev server is HTTP.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue driver. "database" everywhere except tests; "sync" would run receipt
# extraction inside the web request, which cannot fit a 60s serverless budget.
# Serverless deploys have no worker process, so the queue is drained by the
# /cron/drain-queue endpoint (see the cron section below); a host with a shell
# runs `php artisan queue:work` (or Horizon on redis) instead.
# NOTE: the Vercel Hobby plan allows only two daily cron jobs, so vercel.json
# schedules just expire-trials and mark-overdue-invoices. Point an external
# pinger (cron-job.org, GitHub Actions, …) at /cron/drain-queue every minute
# and at /cron/reset-quotas and /cron/renew-subscriptions daily, or upgrade to
# Pro and add them back to vercel.json. Without a drain, queued receipt
# extraction never runs.
QUEUE_CONNECTION=database
# Queues drained by `settlo:drain-queue`, in priority order, plus the limits
# that keep one drain inside the function's execution budget.
SETTLO_DRAIN_QUEUES=default,files,ai
SETTLO_DRAIN_MAX_TIME=45
SETTLO_DRAIN_TRIES=3
# MB; must stay under the function's memory limit.
SETTLO_DRAIN_MEMORY=512

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@settlo.ch"
MAIL_FROM_NAME="Settlo"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Serverless (Vercel) deployment — defaults keep local dev unchanged.
# Production values: APP_ENV=production, APP_DEBUG=false, SESSION_SECURE_COOKIE=true,
# QUEUE_CONNECTION=database (drained by /cron/drain-queue — never sync, which
# would run receipt extraction inside the request), CACHE_STORE=database,
# BROADCAST_CONNECTION=null, LOG_CHANNEL=stderr, RECEIPTS_DISK_DRIVER=s3,
# PUBLIC_DISK_DRIVER=s3, LIVEWIRE_TMP_DISK=receipts, plus GEMINI_API_KEY and
# CRON_SECRET below.
#
# After the first deploy (and after any migration), run the reference-data
# step once — it is idempotent and safe to repeat:
#   curl -fsS "https://<host>/cron/deploy?token=$CRON_SECRET"
# or, with a shell: `php artisan settlo:deploy`. Without it the canton,
# commune and postal-code pickers are empty.
RECEIPTS_DISK_DRIVER=local
PUBLIC_DISK_DRIVER=local
# LIVEWIRE_TMP_DISK=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
# CDN base without path suffix, e.g. https://<bucket>.fra1.cdn.digitaloceanspaces.com
DO_SPACES_CDN_URL=

# Scheduled commands over HTTP
# ----------------------------
# Serverless deploys run no `schedule:run` daemon, so the four lifecycle
# commands and the queue drain are exposed as GET /cron/{command}, guarded by
# this shared secret. With CRON_SECRET empty every endpoint answers 503 and
# nothing can be triggered — which also means that leaving it empty is how
# trials never expire and subscriptions never renew. Generate one with
# `php -r "echo bin2hex(random_bytes(32));"`.
#
# vercel.json declares the schedule; Vercel attaches this value as
# `Authorization: Bearer <CRON_SECRET>` once the variable exists in the project.
# Any other pinger can use the query fallback instead:
#   https://<host>/cron/expire-trials?token=<CRON_SECRET>
# Commands: expire-trials, reset-quotas, renew-subscriptions,
#           mark-overdue-invoices, drain-queue, deploy.
# Note: Vercel cron schedules are UTC, and minute-level schedules need a Pro
# plan (Hobby allows two daily jobs).
CRON_SECRET=

# Google Gemini (receipt/invoice OCR + Ask Settlo chat)
# -----------------------------------------------------
# REQUIRED outside local/testing. Without a key the app refuses to serve HTTP
# requests, because the fallbacks are deterministic stand-ins: every chat answer
# is the same paragraph and every receipt becomes the same CHF 87.50 train
# ticket (marked `model_used: fake`, confidence 0).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# Extraction must fit the serverless execution limit: worst case is
# ATTEMPTS * (CONNECT_TIMEOUT + TIMEOUT) + 0.5s ≈ 40s against a 60s function.
GEMINI_EXTRACT_TIMEOUT=15
GEMINI_EXTRACT_CONNECT_TIMEOUT=5
GEMINI_EXTRACT_ATTEMPTS=2
GEMINI_CHAT_TIMEOUT=45
GEMINI_CHAT_MAX_OUTPUT_TOKENS=8192
GEMINI_CHAT_THINKING_LEVEL=low

# Reverb (broadcasting)
# ---------------------
# Only used with BROADCAST_CONNECTION=reverb and a running `reverb:start`
# process; serverless deploys keep BROADCAST_CONNECTION=null and poll instead.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Stripe (test mode) via Laravel Cashier. Without STRIPE_SECRET the local DummyGateway is used
# in local/testing only; any other environment fails loudly.
STRIPE_KEY=
STRIPE_SECRET=
# Required outside local/testing: webhooks are refused without a signing secret
# (`stripe listen` prints its own whsec_... for local forwarding).
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=chf
CASHIER_CURRENCY_LOCALE=de_CH
# "stripe", "simulated" or "dummy". "simulated" marks a subscription as paid in-process
# without charging any card — it is allowed in every environment, but only when it is set
# here explicitly. Flip this to `stripe` for real Stripe Checkout. "dummy" is a local-only
# signed-URL stand-in and is never allowed in production.
SETTLO_PAYMENT_GATEWAY=simulated
# Coupon ids for the multi-business discounts. Empty uses settlo-workspace-20 / -30,
# which `php artisan settlo:stripe-sync-plans` creates.
STRIPE_COUPON_WORKSPACE_20=
STRIPE_COUPON_WORKSPACE_30=

# Legal links shown at registration (terms version is stored on the user)
SETTLO_TERMS_URL=https://settlo.ch/terms
SETTLO_PRIVACY_URL=https://settlo.ch/privacy
SETTLO_TERMS_VERSION=2026-09

# SMS one-time code after registration (off until an SMS provider is chosen)
SETTLO_PHONE_VERIFICATION=false
SETTLO_PHONE_VERIFICATION_DRIVER=log

# Fiscal year used for estimates, VAT periods and year-end exports. Defaults to
# the current year in Europe/Zurich — set it only to pin a closing year.
# SETTLO_FISCAL_YEAR=2026

# Ask Settlo chat requests per authenticated user per minute. Every turn is a
# billed model call, so this is the cost ceiling as much as a DoS guard.
SETTLO_ASK_RATE_LIMIT=30

# Enforce plan feature gates. Off for the POC — every plan sees every screen
# ("no hard paywalls"), while the plan tier stays visible in Billing and in the
# workspace. Set it to true to charge for the gated features again; escalation
# quotas are enforced either way.
SETTLO_ENFORCE_FEATURE_GATES=false

# Seed the demo fixtures (Anna Müller, her two businesses, the accounting firm)
# outside local/testing. With this on, `php artisan settlo:seed-demo` — and the
# deploy step — create the demo accounts with STRONG generated passwords that
# are printed once to the console and the log. Leave it false for a real
# production tenant: it creates logins.
SETTLO_SEED_DEMO_DATA=false

# Security headers (App\Http\Middleware\SecurityHeaders)
# HSTS is only emitted over HTTPS; 0 suppresses it. The CSP is conservative —
# Filament/Livewire/Alpine need inline scripts and eval — so it mainly locks
# down framing, base-uri, form-action and object-src.
SETTLO_HSTS_MAX_AGE=31536000
SETTLO_CSP_ENABLED=true
