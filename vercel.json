{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "regions": [
        "fra1"
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 60,
            "excludeFiles": "{settlo-specs,tests,latest_requirements,.claude,.planning,node_modules,scripts}/**"
        }
    },
    "crons": [
        {
            "path": "/cron/expire-trials",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/cron/mark-overdue-invoices",
            "schedule": "0 2 * * *"
        }
    ],
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/js/$1"
        },
        {
            "src": "/css/(.*)",
            "dest": "/css/$1"
        },
        {
            "src": "/fonts/(.*)",
            "dest": "/fonts/$1"
        },
        {
            "src": "/images/(.*)",
            "dest": "/images/$1"
        },
        {
            "src": "/vendor/(.*)",
            "dest": "/vendor/$1"
        },
        {
            "src": "/favicon\\.ico",
            "dest": "/favicon.ico"
        },
        {
            "src": "/robots\\.txt",
            "dest": "/robots.txt"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
